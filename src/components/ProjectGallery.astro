---
import { projects } from '../data/projects';
import '../styles/projects.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const entries = projects.filter(project => project.visible);
const asset = (path: string) => /^(https?:\/\/|data:)/i.test(path) ? path : base + '/' + path.replace(/^\/+/, '');
const number = (index: number) => String(index + 1).padStart(2, '0');
---

<div class="project-gallery" data-project-gallery role="region" aria-labelledby="projects-heading">
  {entries.length ? <>
    <div class="project-library" data-reveal="fade" data-reveal-delay="140">
      <div class="library-caption"><span>瀏覽作品<i aria-hidden="true"></i><span data-project-current>01</span><span class="library-total"> / {number(entries.length - 1)}</span></span></div>
      <div class="project-rail">
        <button type="button" class="project-edge edge-left" data-project-scroll="-1" aria-label="向左瀏覽專案" hidden><span aria-hidden="true">←</span></button>
        <div class="project-track" data-project-track aria-label="專案選擇">
          {entries.map((project, index) => <a class="project-tab" data-project-tab data-project-id={project.id} href={'#project-panel-' + project.id} id={'project-tab-' + project.id} aria-label={'作品 ' + number(index) + '：' + project.name + (project.status === 'reserved' ? '（預留席位）' : '')}>
            <span class:list={['tab-art', { 'has-cover': !!project.cover }]} aria-hidden="true">
              {project.cover ? <img src={asset(project.cover.src)} alt="" width="240" height="135" loading="lazy" decoding="async" /> : <span class="tab-blank"><span class="tab-orbit"></span><span class="tab-star">✦</span></span>}
              <span class="tab-number">{number(index)}</span>
            </span>
            <span class="tab-label"><span>{project.name}</span><small>{project.status === 'reserved' ? '預留' : '作品'}</small></span>
          </a>)}
        </div>
        <button type="button" class="project-edge edge-right" data-project-scroll="1" aria-label="向右瀏覽專案" hidden><span aria-hidden="true">→</span></button>
      </div>
      <div class="library-baseline" aria-hidden="true"><span></span></div>
      <p class="sr-only" data-project-status role="status" aria-live="polite" aria-atomic="true"></p>
    </div>
    <div class="project-stage">
      {entries.map((project, index) => <article class="project-panel" id={'project-panel-' + project.id} data-project-panel data-project-title={project.name} aria-labelledby={'project-title-' + project.id}>
        <div class="project-panel-motion">
          <div class="project-story" data-reveal="left" data-reveal-delay="80">
            <div class="project-kicker"><span class="project-edition">PROJECT / {number(index)}</span><span class:list={['project-state', { 'is-reserved': project.status === 'reserved' }]}>{project.status === 'reserved' ? '預留席位' : '已收錄'}</span><p class="project-category">{project.category}{project.year && ' / ' + project.year}</p></div>
            <h3 id={'project-title-' + project.id} class="project-name">{project.name}</h3>
            <p class="project-poem">{project.subtitle}</p>
            <p class="project-description">{project.description}</p>
            {project.role && <p class="project-role">我的角色<span>{project.role}</span></p>}
            {project.tags.length > 0 && <ul class="tags" aria-label={project.name + ' 專案技術'}>{project.tags.map(tag => <li>{tag}</li>)}</ul>}
            <div class="project-actions">{project.status === 'published' ? project.links.map(link => <a class="text-link" href={link.href.startsWith('/') ? asset(link.href) : link.href} target="_blank" rel="noopener noreferrer">{link.label}<span aria-hidden="true">↗</span><span class="sr-only">（另開分頁）</span></a>) : <span class="project-waiting"><i aria-hidden="true"></i>未來作品，敬請期待。</span>}</div>
          </div>
          <div class:list={['project-visual', { 'is-reserved': project.status === 'reserved' }]} data-reveal="right" data-reveal-delay="80">
            <div class="project-frame">
              <div class="frame-bar" aria-hidden="true"><span class="frame-reticle">＋<i></i></span>{project.status === 'reserved' && <span>UNMAPPED POSSIBILITY</span>}<span>FIELD / {number(index)}</span></div>
              <div class="project-canvas">
                {project.cover ? <img src={asset(project.cover.src)} alt={project.cover.alt} width="1672" height="941" loading="lazy" decoding="async" style={{ 'object-fit': project.cover.fit ?? 'cover', 'object-position': project.cover.position ?? 'center' }} /> : <div class="project-blank" aria-hidden="true">
                  <span class="blank-grid"></span>
                  <svg class="blank-constellation" viewBox="0 0 400 260" fill="none">
                    <g class="atlas-orbits"><circle cx="238" cy="124" r="75" stroke-dasharray="2 6" /><ellipse cx="238" cy="124" rx="123" ry="42" transform="rotate(-28 238 124)" /><ellipse cx="238" cy="124" rx="104" ry="48" transform="rotate(36 238 124)" /><path d="M92 101 154 78 211 126 263 91 325 128M154 78 167 171 211 126 274 188" /></g>
                    <g class="atlas-stars"><circle cx="92" cy="101" r="2" /><circle cx="154" cy="78" r="3" /><circle cx="211" cy="126" r="2.5" /><circle cx="263" cy="91" r="2" /><circle cx="325" cy="128" r="2.5" /><circle cx="167" cy="171" r="2" /><circle cx="274" cy="188" r="3" /></g>
                    <path class="atlas-north-star" d="m238 101 4.5 18.5L261 124l-18.5 4.5L238 147l-4.5-18.5L215 124l18.5-4.5Z" />
                  </svg>
                  <span class="blank-index">{number(index)}</span><span class="blank-title">{project.status === 'reserved' ? 'AN UNWRITTEN ORBIT' : 'PROJECT PREVIEW'}</span><span class="blank-subtitle">{project.status === 'reserved' ? '為新的可能，留一個位置。' : '專案圖像尚未提供'}</span>
                </div>}
                <span class="canvas-coordinate coordinate-top" aria-hidden="true">α / {number(index)}.00</span><span class="canvas-coordinate coordinate-bottom" aria-hidden="true">STC — CELESTIAL ARCHIVE</span>
              </div>
            </div>
            <div class="visual-caption" aria-hidden="true"><span>{project.status === 'reserved' ? 'A STAR YET TO BE NAMED' : 'DESIGN MEETS DEVELOPMENT'}</span><span>{number(index)} / {number(entries.length - 1)}<i></i>STC</span></div>
          </div>
        </div>
      </article>)}
    </div>
  </> : <p class="gallery-empty">這裡留給下一件作品。</p>}
</div>

<script src="../scripts/projects.ts"></script>
