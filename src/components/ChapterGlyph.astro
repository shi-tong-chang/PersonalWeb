---
interface Props {
  name: 'about' | 'projects' | 'skills' | 'timeline' | 'contact';
}

const { name } = Astro.props;
---

<svg
  class="chapter-glyph"
  viewBox="0 0 32 32"
  aria-hidden="true"
  focusable="false"
  data-glyph={name}
  fill="none"
  stroke="currentColor"
  stroke-width="1.2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {name === 'about' && (
    <g>
      <circle cx="16" cy="16" r="10" opacity=".6" />
      <path d="m16 3 3 10 10 3-10 3-3 10-3-10-10-3 10-3Z" />
      <circle cx="16" cy="16" r="1.4" fill="currentColor" stroke="none" />
    </g>
  )}

  {name === 'projects' && (
    <g>
      <path d="m16 7 8 5v10l-8 5-8-5V12Z" />
      <path d="m8 12 8 5 8-5m-8 5v10" />
      <path d="M7 25c-3.1.9-5.2.4-5.4-1.4-.2-1.5 1.2-3.6 3.4-5.8M26 12c2.4-2.8 3.3-5.6 2.1-6.7-1.1-1.1-3.7-.4-6.7 1.3" opacity=".7" />
      <circle cx="27.3" cy="13.6" r="1.3" fill="currentColor" stroke="none" />
    </g>
  )}

  {name === 'skills' && (
    <g>
      <path d="M16 7v6m8.2-.8-5.4 2.6M23 23l-4.8-4.8M9 24.2l5-5.9M6.8 12.9l6.5 2.1" />
      <circle cx="16" cy="16" r="3" />
      <circle cx="16" cy="4.5" r="2.5" />
      <circle cx="26.5" cy="11" r="2.5" />
      <circle cx="24.8" cy="24.8" r="2.5" />
      <circle cx="7.5" cy="26" r="2.5" />
      <circle cx="4.5" cy="12" r="2.5" />
      <circle cx="16" cy="16" r=".9" fill="currentColor" stroke="none" />
    </g>
  )}

  {name === 'timeline' && (
    <g>
      <path d="m10.5 19.2-2 9.8 7.5-4 7.5 4-2-9.8" />
      <circle cx="16" cy="13" r="8" />
      <path d="m16 7.8 1.5 3.3 3.5.4-2.6 2.4.7 3.4-3.1-1.7-3.1 1.7.7-3.4-2.6-2.4 3.5-.4Z" />
      <path d="M6 7 4.5 5.5M26 7l1.5-1.5M16 2v1" opacity=".65" />
    </g>
  )}

  {name === 'contact' && (
    <g>
      <path d="M4 13 29 3 20 28l-5-10Z" />
      <path d="M15 18 29 3" />
      <path d="m8 21-3 3m7 1-2.5 4M5 18l-3 1" opacity=".65" />
    </g>
  )}
</svg>
