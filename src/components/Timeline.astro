---
import StarField from './StarField.astro';
import { timelineCopy, timelineEvents, type TimelineEvent } from '../data/timeline';
import '../styles/timeline.css';

interface Props {
  events?: TimelineEvent[];
}

const { events = timelineEvents } = Astro.props;
---

<section class="chapter timeline" id="timeline" aria-labelledby="timeline-heading" tabindex="-1">
  <StarField chart="timeline" offset={2} />
  <div class="section-inner timeline-layout">
    <div class="timeline-heading" data-reveal>
      <p class="eyebrow">{timelineCopy.eyebrow}</p>
      <h2 id="timeline-heading">{timelineCopy.heading.map(line => <span>{line}</span>)}</h2>
      <p class="timeline-introduction">{timelineCopy.introduction}</p>
      <div class="timeline-orbit" aria-hidden="true">
        <svg viewBox="0 0 280 170" focusable="false">
          <g fill="none" stroke="currentColor" stroke-width=".7">
            <ellipse cx="135" cy="80" rx="114" ry="40" transform="rotate(-23 135 80)" opacity=".55" />
            <ellipse cx="135" cy="80" rx="90" ry="61" transform="rotate(12 135 80)" opacity=".2" />
            <path d="m38 117 58-31 45 7 65-55 37 26" opacity=".65" />
            <circle cx="141" cy="93" r="17" stroke-dasharray="1 5" opacity=".55" />
          </g>
          <g fill="currentColor">
            <circle cx="38" cy="117" r="2" />
            <circle cx="96" cy="86" r="2.5" />
            <path d="m141 83 2.3 7.7L151 93l-7.7 2.3L141 103l-2.3-7.7L131 93l7.7-2.3Z" />
            <circle cx="206" cy="38" r="3" />
            <circle cx="243" cy="64" r="1.5" />
          </g>
        </svg>
        <span>EVERY STEP, A NEW COORDINATE.</span>
      </div>
      {timelineCopy.note && <p class="timeline-note">{timelineCopy.note}</p>}
    </div>

    {events.length > 0 ? (
      <ol class="timeline-events" role="list" aria-label="大事記，依顯示順序排列">
        {events.map((event, index) => (
          <li class="timeline-event" id={event.id} data-reveal>
            <span class="timeline-point" aria-hidden="true"></span>
            <div class="timeline-event-meta">
              <span class="timeline-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              {event.dateTime ? <time class="timeline-date" datetime={event.dateTime}>{event.dateLabel}</time> : <span class="timeline-date">{event.dateLabel}</span>}
            </div>
            <h3 class="timeline-event-title">{event.title}</h3>
            <p class="timeline-description">{event.description}</p>
          </li>
        ))}
      </ol>
    ) : (
      <div class="timeline-empty" data-reveal>
        <span class="timeline-empty-star" aria-hidden="true">✧</span>
        <h3>{timelineCopy.emptyTitle}</h3>
        <p>{timelineCopy.emptyDescription}</p>
      </div>
    )}
  </div>
</section>
