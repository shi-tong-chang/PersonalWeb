---
import { profile, skills, copy, chapters } from '../data/profile';
import ProjectGallery from '../components/ProjectGallery.astro';
import StarField from '../components/StarField.astro';
import '../styles/global.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(`${base}/`, Astro.site).href;
const landscape = `${base}/assets/orbital-atlas-v1.svg`;
---
<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={`${profile.displayName.join(' ')}｜${profile.title}${profile.introduction}`} />
    <meta name="theme-color" content="#070d1c" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="canonical" href={canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Serif+Display&family=Noto+Sans+TC:wght@400;500;600&display=swap" rel="stylesheet" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${profile.displayName.join(' ')}｜${copy.siteName}`} />
    <meta property="og:description" content={profile.title} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(`${base}/assets/orbital-atlas-social.png`, Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="750" />
    <meta property="og:image:alt" content="PersonalWeb 原創星圖：深藍星空、淡紫旋臂與香檳金星軌" />
    <title>{profile.displayName.join(' ')}｜{copy.siteName}</title>
  </head>
  <body data-theme="about">
    <a class="skip-link" href="#about">跳至主要內容</a>
    <header class="site-header">
      <a class="brand" href="#about" aria-label={`${profile.monogram}，回到個人介紹`}><svg class="brand-symbol" viewBox="0 0 32 32" aria-hidden="true"><path d="M16 2 19.3 12.7 30 16 19.3 19.3 16 30 12.7 19.3 2 16 12.7 12.7Z" fill="none" stroke="currentColor"/><circle cx="16" cy="16" r="2" fill="currentColor"/></svg><span class="brand-wordmark">{profile.displayName.join(' ')}<span>PERSONAL PORTFOLIO</span></span></a>
      <nav class="top-nav" aria-label="章節導覽">{chapters.map((chapter, index) => <a href={`#${chapter.id}`} data-chapter={index} aria-current={index === 0 ? 'location' : undefined}>{chapter.label}</a>)}</nav>
      <div class="header-actions"><a class="header-github" href={profile.github} target="_blank" rel="noopener noreferrer">GITHUB <span aria-hidden="true">↗</span><span class="sr-only">（另開分頁）</span></a><a class="header-contact" href="#contact">LET’S CONNECT <span aria-hidden="true">✧</span></a></div>
    </header>

    <main id="main-content" aria-label="個人介紹、作品與探索">
      <section class="chapter about" id="about" aria-labelledby="about-heading" tabindex="-1">
        <div class="hero-scene" aria-hidden="true"><img class="hero-landscape" src={landscape} alt="" width="1600" height="1000" fetchpriority="high" decoding="async" /><div class="scene-stars"><i></i><i></i><i></i></div></div>
        <div class="hero-shade" aria-hidden="true"></div>
        <div class="atlas-caption" aria-hidden="true"><span class="atlas-caption-rule"></span><span>THE ORBITAL ATLAS<small>IDEAS FIND THEIR ORBIT.</small></span></div>
        <div class="section-inner about-layout">
          <div class="hero-copy">
            <p class="eyebrow"><span class="little-star" aria-hidden="true">✦</span>{copy.about.eyebrow}</p>
            <h1 id="about-heading" class="hero-title"><span>{profile.displayName[0]}</span>{' '}<span>{profile.displayName[1]}<i aria-hidden="true">.</i></span></h1>
            <p class="hero-tagline">{profile.title}</p>
            <p class="hero-introduction">{profile.introduction}</p>
            {profile.biography && <p class="biography">{profile.biography}</p>}
            <div class="hero-actions"><a class="primary-button" href="#projects">{copy.about.action}<span aria-hidden="true">↗</span></a><a class="text-link" href="#contact">{copy.about.secondaryAction}<span aria-hidden="true">↗</span></a></div>
          </div>
        </div>
        <div class="hero-colophon"><a class="scroll-cue" href="#projects"><span class="scroll-cue-line" aria-hidden="true"></span>SCROLL TO EXPLORE<span aria-hidden="true">↓</span></a><p>每一次探索，<span>都在點亮自己的星圖。</span></p><span class="scene-label">EST. 2026 <i></i> ALWAYS EXPLORING</span></div>
      </section>

      <section class="chapter projects" id="projects" aria-labelledby="projects-heading" tabindex="-1">
        <StarField chart="projects" />
        <div class="section-inner projects-inner">
          <div class="section-heading work-heading"><div><p class="eyebrow">{copy.projects.eyebrow}</p><h2 id="projects-heading">{copy.projects.heading[0]}，<br class="mobile-break" />{copy.projects.heading[1]}</h2></div><p class="section-subtitle">{copy.projects.subtitle}</p></div>
          <div class="project-atlas" id="project-archive">
            <ProjectGallery />
          </div>
          <p class="work-footnote">{copy.projects.footer}</p>
        </div>
      </section>

      <section class="chapter skills" id="skills" aria-labelledby="skills-heading" tabindex="-1">
        <StarField chart="skills" offset={1} />
        <div class="section-inner skills-layout">
          <div class="skills-heading"><p class="eyebrow">{copy.skills.eyebrow}</p><h2 id="skills-heading"><span>{copy.skills.heading[0]}</span><span>{copy.skills.heading[1]}</span></h2><p class="section-subtitle">{copy.skills.subtitle}</p><div class="thought-orbit" aria-hidden="true"><svg viewBox="0 0 320 240"><defs><radialGradient id="thought-glow"><stop stop-color="#c0bad2" stop-opacity=".5"/><stop offset="1" stop-color="#c0bad2" stop-opacity="0"/></radialGradient></defs><circle cx="150" cy="120" r="108" fill="url(#thought-glow)"/><g fill="none" stroke="currentColor" stroke-width=".7"><ellipse cx="150" cy="120" rx="132" ry="42" transform="rotate(-32 150 120)"/><ellipse cx="150" cy="120" rx="132" ry="42" transform="rotate(32 150 120)"/><circle cx="150" cy="120" r="72" stroke-dasharray="2 7"/></g><path d="m150 96 5 19 19 5-19 5-5 19-5-19-19-5 19-5Z" fill="currentColor"/><circle cx="260" cy="56" r="4" fill="currentColor"/></svg><span>CURIOUS BY NATURE.</span></div></div>
          <div class="skill-list">{skills.map(skill => <article class="skill-card"><span class="skill-number">{skill.number}</span><div><p class="skill-english">{skill.english}</p><h3>{skill.title}</h3><p class="skill-description">{skill.description}</p>{skill.tags.length > 0 && <ul class="tags" aria-label={skill.title}>{skill.tags.map(tag => <li>{tag}</li>)}</ul>}</div><span class="skill-star" aria-hidden="true">✧</span></article>)}<p class="skills-note">{copy.skills.note}</p></div>
        </div>
      </section>

      <section class="chapter contact" id="contact" aria-labelledby="contact-heading" tabindex="-1">
        <StarField chart="contact" offset={2} />
        <div class="section-inner contact-layout">
          <div class="contact-copy"><p class="eyebrow">{copy.contact.eyebrow}</p><h2 id="contact-heading">{copy.contact.heading[0]}，<br />{copy.contact.heading[1]}</h2><p class="contact-introduction">{copy.contact.introduction}</p><div class="contact-actions"><a class="primary-button" href={profile.github} target="_blank" rel="noopener noreferrer">{copy.contact.action}<span aria-hidden="true">↗</span><span class="sr-only">（另開分頁）</span></a>{profile.email && <div class="email-actions"><a href={`mailto:${profile.email}`}>{profile.email}</a><button type="button" id="copy-email" data-email={profile.email}>複製 Email</button><span id="copy-status" role="status"></span></div>}</div><p class="contact-signature">{copy.contact.signature}</p></div>
          <figure class="guide-art"><div class="guide-window" aria-hidden="true"><svg class="signal-chart" viewBox="0 0 440 400"><defs><radialGradient id="signal-glow"><stop stop-color="#a68abf" stop-opacity=".28"/><stop offset="1" stop-color="#a68abf" stop-opacity="0"/></radialGradient></defs><circle cx="220" cy="198" r="190" fill="url(#signal-glow)"/><g fill="none" stroke="currentColor" stroke-width=".7"><circle cx="220" cy="198" r="152" opacity=".3"/><circle cx="220" cy="198" r="113" opacity=".5"/><circle cx="220" cy="198" r="178" stroke-dasharray="1 11" opacity=".5"/><ellipse cx="220" cy="198" rx="190" ry="65" transform="rotate(-35 220 198)" opacity=".6"/><path d="M220 30v29m0 278v29M52 198h25m286 0h25" opacity=".7"/><path d="m125 133 95 65 92-116M220 198l89 72-25 98" opacity=".3"/></g><g fill="currentColor"><circle cx="125" cy="133" r="3"/><circle cx="312" cy="82" r="4"/><circle cx="309" cy="270" r="3"/><circle cx="284" cy="368" r="2"/><path d="m220 162 7 29 29 7-29 7-7 29-7-29-29-7 29-7Z"/></g></svg><span class="signal-label">A SIGNAL, A POSSIBILITY.</span></div><figcaption><span>OPEN CHANNEL / 04</span><span>我們下個章節見。<span aria-hidden="true">✦</span></span></figcaption></figure>
        </div>
        <footer class="site-footer"><a class="footer-name" href="#about">{profile.displayName.join(' ')}<span aria-hidden="true">✦</span></a><p>© {new Date().getFullYear()} · BUILT WITH CURIOSITY</p><a class="back-top" href="#about">回到開場<span aria-hidden="true">↑</span></a></footer>
      </section>
    </main>
    <nav class="chapter-rail" aria-label="快速章節索引">{chapters.map((chapter, index) => <a href={`#${chapter.id}`} data-chapter={index} aria-label={`${chapter.number} ${chapter.label}`} aria-current={index === 0 ? 'location' : undefined}><span class="rail-label">{chapter.label}</span><span class="rail-point" aria-hidden="true"></span></a>)}</nav>
    <div class="chapter-dock">
      <div class="chapter-position" aria-label="章節進度"><span id="current-chapter">01</span><span class="chapter-divider">/</span><span>{String(chapters.length).padStart(2, '0')}</span><span class="chapter-progress" aria-hidden="true"><span id="progress-fill"></span></span></div>
      <span class="dock-caption" aria-hidden="true">A PERSONAL UNIVERSE <span>✦</span> AN ONGOING EXPLORATION</span>
      <a id="next-chapter" href="#projects"><span id="next-label">下一章</span><span id="next-arrow" aria-hidden="true">↓</span></a>
    </div>
    <script src="../scripts/chapters.ts"></script>
  </body>
</html>
