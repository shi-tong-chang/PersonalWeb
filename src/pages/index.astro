---
import { profile, projects, skills, copy, chapters } from '../data/profile';
import FourArts from '../components/FourArts.astro';
import '../styles/global.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(`${base}/`, Astro.site).href;
const landscape = `${base}/assets/ink-landscape-v1.webp`;
---
<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={`${profile.displayName.join(' ')}｜${profile.title}${profile.introduction}`} />
    <meta name="theme-color" content="#f3f0e7" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="canonical" href={canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=LXGW+WenKai+TC:wght@700&family=Noto+Serif+TC:wght@400;500;600;700&family=DM+Sans:wght@400;500&display=swap" rel="stylesheet" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${profile.displayName.join(' ')}｜${copy.siteName}`} />
    <meta property="og:description" content={profile.title} />
    <meta property="og:url" content={canonical} />
    <title>{profile.displayName.join(' ')}｜{copy.siteName}</title>
  </head>
  <body data-theme="about">
    <a class="skip-link" href="#about">跳至主要內容</a>
    <header class="site-header">
      <a class="brand" href="#about" aria-label={`${profile.monogram}，回到個人介紹`}><span class="seal brand-seal" aria-hidden="true">知<br />行</span><span class="brand-wordmark">{copy.siteName}<small>{profile.monogram} · PERSONAL SCROLL</small></span></a>
      <nav class="top-nav" aria-label="章節導覽">{chapters.map((chapter, index) => <a href={`#${chapter.id}`} data-chapter={index} aria-current={index === 0 ? 'location' : undefined}><span class="nav-art" aria-hidden="true">{chapter.character}</span><span>{chapter.label}</span></a>)}</nav>
      <a class="header-contact" href="#contact"><span>共 敘</span><span aria-hidden="true">↗</span></a>
    </header>

    <main class="swiper chapters" id="main-content" aria-label="琴棋書畫，四章個人介紹">
      <div class="swiper-wrapper">
        <section class="swiper-slide chapter about" id="about" aria-labelledby="about-heading" tabindex="-1">
          <img class="landscape hero-landscape" src={landscape} alt="" width="1536" height="1024" fetchpriority="high" decoding="async" />
          <div class="section-inner about-layout">
            <div class="hero-copy">
              <p class="eyebrow reveal"><span class="tiny-seal">序</span>{copy.about.eyebrow}</p>
              <h1 id="about-heading" class="hero-title brush reveal"><span>{copy.about.heading[0]}</span><span>{copy.about.heading[1]}<i class="title-dot" aria-hidden="true"></i></span></h1>
              <div class="hero-identity reveal"><span class="identity-line" aria-hidden="true"></span><p>{profile.displayName.join(' ')}<small>{profile.name}</small></p><span class="seal name-seal" aria-hidden="true">無<br />界</span></div>
              <p class="hero-introduction reveal">{profile.introduction}</p>
              {profile.biography && <p class="biography reveal">{profile.biography}</p>}
              <div class="hero-actions reveal"><a class="ink-button" href="#projects">{copy.about.action}<span aria-hidden="true">⟶</span></a><a class="text-link" href="#contact">{copy.about.secondaryAction}<span aria-hidden="true">↗</span></a></div>
            </div>
            <aside class="hero-inscription reveal" aria-label="四藝意象"><span>以琴養心</span><span>以棋謀局</span><span>以書明理</span><span>以畫觀物</span><i class="seal" aria-hidden="true">四<br />藝</i></aside>
            <div class="hero-colophon reveal"><span>{copy.about.signature}</span><a href="#projects">向下展卷<span aria-hidden="true">↓</span></a></div>
          </div>
        </section>

        <section class="swiper-slide chapter projects" id="projects" aria-labelledby="projects-heading" tabindex="-1">
          <span class="watermark brush" aria-hidden="true">棋</span>
          <div class="section-inner work-layout">
            <div class="section-heading reveal"><p class="eyebrow">{copy.projects.eyebrow}</p><h2 id="projects-heading" class="brush">{copy.projects.heading[0]}<br />{copy.projects.heading[1]}</h2><p class="section-subtitle">{copy.projects.subtitle}</p><FourArts art="qi" class="chapter-symbol" /><p class="small-note">{copy.projects.footer}</p></div>
            <div class="work-gallery">{projects.map(project => <article class="project reveal">
              <a class="project-art" href={project.url} target="_blank" rel="noopener noreferrer" aria-label={`查看 ${project.name} GitHub 專案（另開分頁）`}>
                <div class="scroll-roller roller-top" aria-hidden="true"></div>
                <div class="project-painting"><img src={landscape} alt="水墨山水與松下琴亭，PersonalWeb 的視覺主題" width="1536" height="1024" loading="lazy" decoding="async" /><div class="painting-title"><span class="brush">知行之間</span><span class="painting-subtitle">一卷山水 · 一方天地</span><i class="seal" aria-hidden="true">作<br />品</i></div><span class="painting-index">作品 / {project.number}</span><span class="painting-link" aria-hidden="true">↗</span></div>
                <div class="scroll-roller roller-bottom" aria-hidden="true"></div>
              </a>
              <div class="project-meta"><div><p class="eyebrow">{project.category} · {project.year}</p><h3>{project.name}</h3></div><a class="text-link project-link" href={project.url} target="_blank" rel="noopener noreferrer">{copy.projects.action}<span aria-hidden="true">↗</span><span class="sr-only">（另開分頁）</span></a></div>
              <p class="project-description">{project.description}</p><ul class="tags" aria-label="專案技術">{project.tags.map(tag => <li>{tag}</li>)}</ul>
            </article>)}</div>
          </div>
        </section>

        <section class="swiper-slide chapter skills" id="skills" aria-labelledby="skills-heading" tabindex="-1">
          <span class="watermark brush" aria-hidden="true">書</span>
          <div class="section-inner skills-layout">
            <div class="skills-heading reveal"><div class="section-heading"><p class="eyebrow">{copy.skills.eyebrow}</p><h2 id="skills-heading" class="brush"><span class="heading-line">{copy.skills.heading[0]}</span><span class="heading-pause">，</span><span class="heading-line">{copy.skills.heading[1]}</span></h2></div><p class="section-subtitle">{copy.skills.subtitle}</p></div>
            <div class="four-arts-grid">{skills.map(skill => <article class="art-card reveal" data-art={skill.art}><div class="art-card-top"><span>{skill.number}</span><span class="art-name brush">{skill.character}</span></div><FourArts art={skill.art} class="art-illustration" /><h3>{skill.title}</h3><p class="skill-description">{skill.description}</p>{skill.tags.length > 0 && <ul class="tags" aria-label={skill.title}>{skill.tags.map(tag => <li>{tag}</li>)}</ul>}</article>)}</div>
            <div class="skills-colophon reveal"><p>{copy.skills.note}</p><span class="small-seal" aria-hidden="true">融會貫通</span></div>
          </div>
        </section>

        <section class="swiper-slide chapter contact" id="contact" aria-labelledby="contact-heading" tabindex="-1">
          <img class="landscape contact-landscape" src={landscape} alt="" width="1536" height="1024" loading="lazy" decoding="async" />
          <div class="section-inner contact-layout">
            <div class="contact-art reveal" aria-hidden="true"><div class="moon-window"><img src={landscape} alt="" width="1536" height="1024" loading="lazy" decoding="async" /><div class="moon-border"></div><span class="moon-poem">山水之間<br />自有回響</span></div><FourArts art="hua" class="contact-symbol" /><span class="seal moon-seal">相<br />逢</span></div>
            <div class="contact-copy reveal"><p class="eyebrow">{copy.contact.eyebrow}</p><h2 id="contact-heading" class="brush">{copy.contact.heading[0]}<br />{copy.contact.heading[1]}</h2><h3>{copy.contact.title}</h3><p class="contact-introduction">{copy.contact.introduction}</p><div class="contact-actions"><a class="ink-button" href={profile.github} target="_blank" rel="noopener noreferrer">{copy.contact.action}<span aria-hidden="true">↗</span><span class="sr-only">（另開分頁）</span></a>{profile.email && <div class="email-actions"><a href={`mailto:${profile.email}`}>{profile.email}</a><button type="button" id="copy-email" data-email={profile.email}>複製 Email</button><span id="copy-status" role="status"></span></div>}</div><div class="contact-signature"><span>{profile.displayName.join(' ')}</span><span>{copy.contact.signature}</span></div></div>
          </div>
        </section>
      </div>
    </main>

    <aside class="chapter-rail" aria-label="章節快速跳轉">{chapters.map((chapter, index) => <a href={`#${chapter.id}`} data-chapter={index} aria-label={`${chapter.number}，${chapter.label}`} aria-current={index === 0 ? 'location' : undefined}><span>{chapter.character}</span><i></i></a>)}</aside>
    <footer class="site-footer"><span class="footer-label">{profile.monogram}<i></i>琴棋書畫 · 知行無界<span class="footer-year">© {new Date().getFullYear()}</span></span><div class="chapter-progress"><span id="current-chapter">01</span><span class="progress-line"><span id="progress-fill"></span></span><span>04</span></div><a href="#projects" id="next-chapter"><span id="next-label">向下展卷</span><span id="next-arrow" aria-hidden="true">↓</span></a></footer>
    <script src="../scripts/chapters.ts"></script>
  </body>
</html>
