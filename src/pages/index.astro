---
import { profile, projects, skills } from '../data/profile';
import '../styles/global.css';

const chapters = [
  { id: 'about', label: '個人介紹' },
  { id: 'projects', label: '專案經歷' },
  { id: 'skills', label: '擅長技能' },
  { id: 'contact', label: '聯繫方式' },
];
const canonical = new URL(`${import.meta.env.BASE_URL}/`, Astro.site).href;
---
<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={`${profile.name} 的個人網站。探索專案經歷、擅長技能，開啟下一次交流。`} />
    <meta name="theme-color" content="#191b1a" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${profile.name} — Personal Space`} />
    <meta property="og:description" content={profile.title} />
    <meta property="og:url" content={canonical} />
    <title>{profile.name} — Personal Space</title>
  </head>
  <body data-theme="about">
    <a class="skip-link" href="#about">跳至主要內容</a>
    <header class="site-header">
      <a class="brand" href="#about" aria-label="STC，回到個人介紹">{profile.monogram}<span class="brand-dot">.</span></a>
      <nav class="top-nav" aria-label="章節導覽">
        {chapters.map((chapter, index) => <a href={`#${chapter.id}`} data-chapter={index} aria-current={index === 0 ? 'location' : undefined}><span class="nav-number">0{index + 1}</span>{chapter.label}</a>)}
      </nav>
      <a class="header-github" href={profile.github} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span><span class="sr-only">（另開分頁）</span></a>
    </header>

    <main class="swiper chapters" id="main-content" aria-label="個人網站的四個章節">
      <div class="swiper-wrapper">
        <section class="swiper-slide chapter about" id="about" aria-labelledby="about-heading" tabindex="-1">
          <div class="section-inner about-layout">
            <div class="hero-copy">
              <p class="eyebrow reveal"><span class="status-dot"></span> A PERSONAL SPACE / {profile.name}</p>
              <h1 id="about-heading" class="hero-title reveal">Ideas into<br /><span>experiences.</span></h1>
              <h2 class="hero-subtitle reveal">{profile.title}</h2>
              <p class="intro reveal">{profile.introduction}</p>
              <a class="pill-button reveal" href="#projects">探索我的專案 <span aria-hidden="true">↗</span></a>
              <p class="content-note reveal">{profile.aboutNote}</p>
            </div>
            <div class="hero-art reveal" aria-hidden="true">
              <div class="art-cross cross-one">+</div><div class="art-cross cross-two">+</div>
              <svg class="orbit-art" viewBox="0 0 560 560" fill="none">
                <circle cx="280" cy="280" r="235" stroke="currentColor" stroke-opacity=".18" stroke-dasharray="2 8" />
                <g transform="rotate(-32 280 280)" stroke="#ff7248" stroke-width="1.2">
                  <ellipse cx="280" cy="280" rx="180" ry="215" />
                  <ellipse cx="280" cy="280" rx="150" ry="215" />
                  <ellipse cx="280" cy="280" rx="110" ry="215" />
                  <ellipse cx="280" cy="280" rx="60" ry="215" />
                  <ellipse cx="280" cy="280" rx="15" ry="215" />
                  <ellipse cx="280" cy="280" rx="180" ry="160" />
                  <ellipse cx="280" cy="280" rx="180" ry="95" />
                  <ellipse cx="280" cy="280" rx="180" ry="30" />
                </g>
                <ellipse cx="280" cy="280" rx="265" ry="76" transform="rotate(-32 280 280)" stroke="#e9e8df" stroke-width="1.5" />
                <circle cx="492" cy="145" r="9" fill="#e9e8df" />
                <circle cx="112" cy="411" r="5" fill="#ff7248" />
              </svg>
              <div class="art-caption"><span>ALWAYS IN PROGRESS</span><span>FIG. 001 ↗</span></div>
            </div>
          </div>
          <span class="background-word" aria-hidden="true">HELLO.</span>
        </section>

        <section class="swiper-slide chapter projects" id="projects" aria-labelledby="projects-heading" tabindex="-1">
          <div class="section-inner">
            <div class="section-heading reveal"><div><p class="eyebrow">02 / SELECTED WORK</p><h2 id="projects-heading">想法落地的<span class="serif-accent">軌跡。</span></h2></div><p class="section-aside">每一次實作，<br />都是下一步的起點。</p></div>
            {projects.map(project => <article class="project-layout reveal">
              <div class="project-art" aria-label="PersonalWeb 網站的抽象版型預覽" role="img">
                <div class="preview-window"><div class="preview-toolbar"><i></i><i></i><i></i><span>personalweb / a space for ideas</span></div><div class="preview-body"><div class="preview-logo">STC.</div><div class="preview-title">Ideas into<br /><em>experiences.</em></div><div class="preview-circle"></div><div class="preview-line"></div><span class="preview-caption">DESIGN. BUILD. ITERATE.</span></div></div>
                <span class="project-art-label">A SPACE OF MY OWN</span><span class="project-art-index">01 — 01</span>
              </div>
              <div class="project-copy"><p class="eyebrow">{project.category} / {project.year}</p><h3>{project.name}<span class="tiny-index"> / {project.number}</span></h3><p>{project.description}</p><ul class="tags" aria-label="專案技術">{project.tags.map(tag => <li>{tag}</li>)}</ul><a class="text-link" href={project.url} target="_blank" rel="noopener noreferrer">查看 GitHub 專案 <span aria-hidden="true">↗</span><span class="sr-only">（另開分頁）</span></a><p class="project-note">更多專案，陸續整理中。</p></div>
            </article>)}
          </div>
        </section>

        <section class="swiper-slide chapter skills" id="skills" aria-labelledby="skills-heading" tabindex="-1">
          <div class="section-inner">
            <div class="section-heading reveal"><div><p class="eyebrow">03 / THE TOOLKIT</p><h2 id="skills-heading">持續累積，<br /><span class="muted-heading">持續創造。</span></h2></div><p class="section-aside">從理解問題開始，<br />找到實現想法的方法。</p></div>
            <div class="skills-grid">{skills.map(skill => <article class="skill-item reveal"><div class="skill-top"><span>{skill.number}</span><span aria-hidden="true">↗</span></div><p class="eyebrow">{skill.english}</p><h3>{skill.title}</h3><p class="skill-description">{skill.description}</p><ul class="tags" aria-label={`${skill.title}內容狀態`}>{skill.tags.map(tag => <li>{tag}</li>)}</ul></article>)}</div>
            <p class="skills-note reveal">專長內容整理中。本站使用 Astro、TypeScript 與 Swiper 製作。</p>
          </div>
        </section>

        <section class="swiper-slide chapter contact" id="contact" aria-labelledby="contact-heading" tabindex="-1">
          <div class="section-inner contact-layout">
            <p class="eyebrow reveal">04 / WHAT'S NEXT?</p>
            <h2 id="contact-heading" class="contact-title reveal">Great things<br />start with <span class="hello-word">hello<svg viewBox="0 0 310 25" aria-hidden="true"><path d="M3 18Q150-8 305 12M28 24Q150 6 270 19" fill="none" stroke="currentColor" stroke-width="3" /></svg></span><span class="contact-period">.</span></h2>
            <div class="contact-bottom reveal"><div><h3>下一個想法，從交流開始。</h3><p>歡迎分享想法、聊聊作品，或單純打聲招呼。</p></div><div class="contact-actions"><a class="contact-button" href={profile.github} target="_blank" rel="noopener noreferrer">到 GitHub 找我 <span aria-hidden="true">↗</span><span class="sr-only">（另開分頁）</span></a>{profile.email && <div class="email-actions"><a href={`mailto:${profile.email}`}>{profile.email}</a><button type="button" id="copy-email" data-email={profile.email}>複製 Email</button><span id="copy-status" role="status"></span></div>}</div></div>
            <div class="contact-signature reveal"><span>{profile.name}</span><span>KEEP EXPLORING. KEEP MAKING.</span></div>
          </div>
          <span class="contact-star" aria-hidden="true">✳</span>
        </section>
      </div>
    </main>

    <aside class="chapter-rail" aria-label="章節快速跳轉">{chapters.map((chapter, index) => <a href={`#${chapter.id}`} data-chapter={index} aria-label={`${index + 1}，${chapter.label}`} aria-current={index === 0 ? 'location' : undefined}><span></span></a>)}</aside>
    <footer class="site-footer"><span class="footer-label">PERSONAL PORTFOLIO <span class="footer-year">© {new Date().getFullYear()}</span></span><div class="chapter-progress"><span id="current-chapter">01</span><span class="progress-line"><span id="progress-fill"></span></span><span class="total-chapters">04</span></div><a href="#projects" id="next-chapter"><span id="next-label">往下探索</span><span id="next-arrow" aria-hidden="true">↓</span></a></footer>
    <script src="../scripts/chapters.ts"></script>
  </body>
</html>
