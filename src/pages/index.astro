---
import { profile, projects, skills, copy } from '../data/profile';
import IdentityMark from '../components/IdentityMark.astro';
import '../styles/global.css';

const chapters = ['about', 'projects', 'skills', 'contact'].map((id, index) => ({ id, label: copy.navigation[index] }));
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(`${base}/`, Astro.site).href;
---
<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={`${profile.name} — ${profile.introduction}`} />
    <meta name="theme-color" content="#f4f2eb" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="canonical" href={canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;650;700;750;800;900&family=Noto+Sans+TC:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${profile.displayName.join(' ')} — Personal Index`} />
    <meta property="og:description" content={profile.title} />
    <meta property="og:url" content={canonical} />
    <title>{profile.displayName.join(' ')} — Personal Index</title>
  </head>
  <body data-theme="about">
    <a class="skip-link" href="#about">跳至主要內容</a>
    <header class="site-header">
      <a class="brand" href="#about" aria-label={`${profile.monogram}，回到個人介紹`}>
        <svg class="brand-symbol" viewBox="0 0 32 32" aria-hidden="true"><path d="M7 2h18l5 5v6H15l5 6h10v6l-5 5H7l-5-5v-6h15l-5-6H2V7Z" fill="currentColor" /></svg>
        <span>{profile.monogram}<span class="brand-dot">↗</span></span>
      </a>
      <nav class="top-nav" aria-label="章節導覽">
        {chapters.map((chapter, index) => <a href={`#${chapter.id}`} data-chapter={index} aria-current={index === 0 ? 'location' : undefined}><span class="nav-number">0{index + 1}</span>{chapter.label}</a>)}
      </nav>
      <a class="header-contact" href="#contact">LET’S TALK <span class="small-arrow" aria-hidden="true">↗</span></a>
    </header>

    <main class="swiper chapters" id="main-content" aria-label="個人網站的四個章節">
      <div class="swiper-wrapper">
        <section class="swiper-slide chapter about" id="about" aria-labelledby="about-heading" tabindex="-1">
          <div class="section-inner about-layout">
            <div class="hero-copy">
              <p class="eyebrow reveal"><span class="signal-dot"></span>{copy.about.eyebrow}<span class="edition">VOL. 01</span></p>
              <h1 class="hero-title reveal" id="about-heading"><span>{profile.displayName[0]}</span><span class="name-line">{profile.displayName[1]}<span class="name-period">.</span></span></h1>
              <div class="hero-description reveal"><span class="intro-rule" aria-hidden="true"></span><div><h2>{profile.title}</h2><p>{profile.introduction}</p>{profile.biography && <p class="biography">{profile.biography}</p>}</div></div>
              <div class="hero-actions reveal"><a class="button button-dark" href="#projects">{copy.about.action}<span aria-hidden="true">↗</span></a><a class="quiet-link" href="#contact">{copy.about.secondaryAction}<span aria-hidden="true">↗</span></a></div>
            </div>
            <figure class="identity-stage reveal" data-parallax>
              <div class="stage-registration"><span>PERSONAL IDENTITY</span><span>001 / STC</span></div>
              <div class="stage-grid" aria-hidden="true"><span class="axis-x"></span><span class="axis-y"></span><span class="orbit orbit-one"></span><span class="orbit orbit-two"></span></div>
              <div class="identity-object"><IdentityMark /></div>
              <figcaption class="stage-caption"><span class="caption-cross" aria-hidden="true">+</span><span>{profile.name}<small>AN INTRODUCTION, IN FOUR CHAPTERS.</small></span><span class="caption-cross" aria-hidden="true">+</span></figcaption>
              <span class="stage-side-note" aria-hidden="true">A DIFFERENT POINT OF VIEW</span>
            </figure>
            <div class="hero-bottom reveal"><span>{copy.about.signature}</span><a href="#projects"><span class="scroll-icon" aria-hidden="true"></span>SCROLL TO GET TO KNOW ME</a></div>
          </div>
        </section>

        <section class="swiper-slide chapter projects" id="projects" aria-labelledby="projects-heading" tabindex="-1">
          <div class="section-inner work-layout">
            <div class="section-heading reveal"><p class="eyebrow"><span class="section-number">02</span>{copy.projects.eyebrow}</p><h2 id="projects-heading">{copy.projects.heading[0]}<br /><span class="accent-word">{copy.projects.heading[1]}</span></h2><p class="section-subtitle">{copy.projects.subtitle}</p><span class="editorial-arrow" aria-hidden="true">↘</span><p class="work-footnote">{copy.projects.footer}</p></div>
            <div class="work-gallery">
              {projects.map(project => <article class="project reveal">
                <a class="project-art" href={project.url} target="_blank" rel="noopener noreferrer" aria-label={`查看 ${project.name} GitHub 專案（另開分頁）`} data-parallax>
                  <div class="project-art-top"><span>FEATURED PROJECT</span><span>/{project.number}</span></div>
                  <div class="preview-window" aria-hidden="true"><div class="preview-toolbar"><span>STC.</span><span>PERSONAL INDEX — 2026</span><i></i></div><div class="preview-content"><div class="preview-copy"><small>A PERSONAL INTRODUCTION</small><strong>{profile.displayName[0]}<br />{profile.displayName[1]}<b>.</b></strong><span class="preview-description">{profile.title}</span><span class="preview-button">EXPLORE MY WORLD ↗</span></div><IdentityMark class="preview-mark" /></div><div class="preview-footer"><span>INTRODUCTION · WORK · SKILLS · CONTACT</span><span>01 / 04</span></div></div>
                  <div class="project-art-bottom"><span>A SPACE OF MY OWN.</span><span class="project-open" aria-hidden="true">↗</span></div>
                </a>
                <div class="project-meta"><div><p class="eyebrow">{project.category} / {project.year}</p><h3>{project.name}<span class="project-dot" aria-hidden="true"></span></h3></div><a class="project-link" href={project.url} target="_blank" rel="noopener noreferrer" aria-label={`${copy.projects.action}（另開分頁）`}><span>{copy.projects.action}</span><span aria-hidden="true">↗</span></a></div>
                <p class="project-description">{project.description}</p>
                <ul class="tags" aria-label="專案技術">{project.tags.map(tag => <li>{tag}</li>)}</ul>
              </article>)}
            </div>
          </div>
        </section>

        <section class="swiper-slide chapter skills" id="skills" aria-labelledby="skills-heading" tabindex="-1">
          <div class="section-inner skills-layout">
            <div class="section-heading reveal"><p class="eyebrow"><span class="section-number">03</span>{copy.skills.eyebrow}</p><h2 id="skills-heading">{copy.skills.heading[0]}<br /><span class="accent-word">{copy.skills.heading[1]}</span></h2><p class="section-subtitle">{copy.skills.subtitle}</p><div class="skills-emblem" aria-hidden="true"><svg viewBox="0 0 140 140"><g fill="none" stroke="currentColor" stroke-width="1.1"><circle cx="70" cy="70" r="59" /><ellipse cx="70" cy="70" rx="24" ry="59" /><ellipse cx="70" cy="70" rx="59" ry="24" /><path d="M11 70h118M70 11v118" /></g><path d="M48 91 91 48M48 48h43v43" fill="none" stroke="currentColor" stroke-width="5" /></svg><span>ALWAYS<br />BECOMING.</span></div></div>
            <div class="skill-list reveal">{skills.map(skill => <article class="skill-row"><span class="skill-index">/{skill.number}</span><div class="skill-content"><p class="skill-english">{skill.english}</p><h3>{skill.title}</h3>{skill.description && <p class="skill-description">{skill.description}</p>}{skill.tags.length > 0 && <ul class="tags" aria-label={skill.title}>{skill.tags.map(tag => <li>{tag}</li>)}</ul>}</div><span class="skill-plus" aria-hidden="true">+</span></article>)}<p class="content-note"><span class="signal-dot"></span>{copy.skills.note}</p></div>
          </div>
        </section>

        <section class="swiper-slide chapter contact" id="contact" aria-labelledby="contact-heading" tabindex="-1">
          <div class="section-inner contact-layout">
            <div class="contact-heading-row reveal"><p class="eyebrow"><span class="section-number">04</span>{copy.contact.eyebrow}</p><span class="contact-note">GOOD CONVERSATIONS. NEW POSSIBILITIES.</span></div>
            <div class="contact-title-row reveal"><h2 id="contact-heading">{copy.contact.heading[0]}<br /><span>{copy.contact.heading[1]}</span></h2><a class="contact-orbit" href={profile.github} target="_blank" rel="noopener noreferrer" aria-label="前往 GitHub 認識我（另開分頁）"><span aria-hidden="true">↗</span><svg viewBox="0 0 160 160" aria-hidden="true"><circle cx="80" cy="80" r="76" fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="1 6" /></svg></a></div>
            <div class="contact-bottom reveal"><div><h3>{copy.contact.title}</h3><p>{copy.contact.introduction}</p></div><div class="contact-actions"><a class="button button-dark" href={profile.github} target="_blank" rel="noopener noreferrer">{copy.contact.action}<span aria-hidden="true">↗</span><span class="sr-only">（另開分頁）</span></a>{profile.email && <div class="email-actions"><a href={`mailto:${profile.email}`}>{profile.email}</a><button type="button" id="copy-email" data-email={profile.email}>複製 Email</button><span id="copy-status" role="status"></span></div>}</div></div>
            <div class="contact-signature reveal"><a href="#about" aria-label="回到個人介紹">{profile.monogram}<span class="signature-dot">.</span></a><span>{copy.contact.signature}</span><span>{profile.name}</span></div>
          </div>
        </section>
      </div>
    </main>

    <aside class="chapter-rail" aria-label="章節快速跳轉">{chapters.map((chapter, index) => <a href={`#${chapter.id}`} data-chapter={index} aria-label={`${index + 1}，${chapter.label}`} aria-current={index === 0 ? 'location' : undefined}><span class="rail-label">0{index + 1}</span><span class="rail-line"></span></a>)}</aside>
    <footer class="site-footer"><span class="footer-label">{profile.monogram} — PERSONAL INDEX <span class="footer-year">© {new Date().getFullYear()}</span></span><div class="chapter-progress"><span id="current-chapter">01</span><span class="progress-line"><span id="progress-fill"></span></span><span class="total-chapters">04</span></div><a href="#projects" id="next-chapter"><span id="next-label">往下探索</span><span id="next-arrow" aria-hidden="true">↓</span></a></footer>
    <script src="../scripts/chapters.ts"></script>
    <script src="../scripts/identity.ts"></script>
  </body>
</html>
